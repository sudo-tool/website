---
const { title, description, emoji, image } = Astro.props;
import { Image } from 'astro:assets';
import Icon from '@components/Icon.astro';
---

<div data-tilt class={`reveal group relative rounded-[20px] border border-white/10 bg-gradient-to-b from-white/[0.075] to-white/[0.025] p-6 backdrop-blur-xl shadow-card card-lift overflow-hidden ${image ? '' : ''}`}>
  <!-- hover aurora wash -->
  <div class="pointer-events-none absolute -top-24 left-1/2 h-48 w-[130%] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(88,101,242,.28),transparent)] opacity-0 blur-2xl transition-opacity duration-700 group-hover:opacity-100"></div>
  <div class="pointer-events-none absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent opacity-60"></div>
  {image ? (
    <div class="relative mb-5 overflow-hidden rounded-2xl border border-white/10 bg-black/30 group/img">
      <Image 
        src={image} 
        alt={title} 
        width={800} 
        height={500} 
        class="w-full aspect-[16/10] cursor-pointer object-cover transition duration-700 group-hover/img:scale-[1.05] group-hover:-translate-y-1"
        data-modal-target={`modal-${title.toLowerCase().replace(/\s+/g, '-')}`}
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#05070f]/70 via-transparent to-transparent opacity-70"></div>
      <span class="absolute left-3 top-3 chip !bg-black/50 !text-white/85 backdrop-blur-md"><Icon name={emoji} class="h-3.5 w-3.5" /> {title}</span>
      <span class="absolute right-3 bottom-3 grid h-9 w-9 place-items-center rounded-full bg-white/12 border border-white/20 backdrop-blur text-white opacity-0 translate-y-2 group-hover/img:opacity-100 group-hover/img:translate-y-0 transition-all duration-500">⤢</span>
    </div>
  ) : (
    <div class="relative mb-5 inline-flex">
      <span class="absolute -inset-2 rounded-[20px] bg-gradient-to-br from-[#5865f2]/40 to-[#67e8f9]/20 blur-lg opacity-40 group-hover:opacity-80 transition-opacity duration-500"></span>
      <span class="relative inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-white/12 bg-gradient-to-b from-white/12 to-white/[0.04] p-3 shadow-card">
        <Icon name={emoji} class="h-6 w-6 text-[#c7d2fe] transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-6" />
      </span>
    </div>
  )}
  <div class="relative mb-2 flex items-center gap-2">
    <h3 class="font-display text-[19px] font-bold text-white tracking-tight">{title}</h3>
    <span class="h-1.5 w-1.5 rounded-full bg-gradient-to-r from-[#818cf8] to-[#67e8f9] opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500"></span>
  </div>
  <p class="relative text-[15px] text-white/65 leading-relaxed text-balance">{description}</p>
  <div class="relative mt-4 h-[3px] w-full overflow-hidden rounded-full bg-white/[0.07]">
    <div class="h-full w-full origin-left scale-x-0 bg-gradient-to-r from-[#5865f2] to-[#67e8f9] transition-transform duration-700 group-hover:scale-x-100"></div>
  </div>
</div>
