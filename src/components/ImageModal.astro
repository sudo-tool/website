---
const { id, image, title } = Astro.props;
import { Image } from 'astro:assets';
---

<div id={id} class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/75 px-4 py-6 sm:px-6 backdrop-blur-md">
  <div class="modal-panel relative w-full max-w-5xl overflow-hidden rounded-[22px] border border-white/12 bg-[#0a0f22]/90 shadow-[0_30px_90px_rgba(0,0,0,.7)]">
    <div class="absolute inset-x-12 top-0 h-px bg-gradient-to-r from-transparent via-[#818cf8]/70 to-transparent"></div>
    <div class="flex items-center justify-between px-5 py-3.5 border-b border-white/10">
      <span class="text-sm font-semibold text-white/75">{title}</span>
      <button class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-white/12 bg-white/[0.06] text-xl font-bold text-white/80 hover:bg-[#5865f2] hover:text-white hover:border-[#5865f2] hover:rotate-90 transition-all duration-400" aria-label="Close modal">
        &times;
      </button>
    </div>
    <div class="max-h-[80vh] overflow-auto p-3 sm:p-4 bg-[radial-gradient(800px_300px_at_50%_0%,rgba(88,101,242,.14),transparent)]">
      <Image 
        src={image} 
        alt={title} 
        width={1400} 
        height={900} 
        class="w-full h-auto object-contain rounded-2xl border border-white/10 bg-black/40"
      />
    </div>
  </div>
</div>
