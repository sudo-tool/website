---
import { Image } from 'astro:assets';
import logo from '../../public/logo.png';
import discordIcon from '../../public/nav-icons/discord.svg';
import githubIcon from '../../public/nav-icons/github.svg';
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="mx-auto max-w-7xl px-3 sm:px-6 lg:px-8">
    <div id="site-header-inner" class="mt-3 rounded-[20px] border border-white/10 bg-[#05070f]/55 backdrop-blur-xl supports-[backdrop-filter]:bg-[#05070f]/45 shadow-[0_10px_30px_rgba(0,0,0,0.35)] transition-all duration-500 relative overflow-hidden">
      <!-- top gradient hairline -->
      <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-[#818cf8]/70 to-transparent"></div>
      <!-- hover sheen -->
      <div class="pointer-events-none absolute -inset-1 opacity-0 hover:opacity-100 transition-opacity duration-700 bg-[radial-gradient(600px_80px_at_50%_-10%,rgba(88,101,242,.18),transparent)]"></div>
      <div class="relative flex items-center justify-between gap-4 px-3 py-2.5 sm:px-4">
        <a href="/" class="group flex items-center gap-3 rounded-2xl px-2 py-1.5 transition">
          <span class="relative inline-flex">
            <span class="absolute -inset-1.5 rounded-2xl bg-gradient-to-br from-[#5865f2]/50 via-[#67e8f9]/25 to-[#a78bfa]/40 blur-[10px] opacity-60 group-hover:opacity-100 transition-opacity duration-500"></span>
            <span class="relative grid h-10 w-10 place-items-center rounded-2xl border border-white/15 bg-white/[0.07] overflow-hidden">
              <Image src={logo} alt="Legcord Logo" class="h-7 w-7 object-contain transition-transform duration-500 group-hover:scale-110 group-hover:rotate-[-6deg]" />
            </span>
          </span>
          <span class="leading-tight">
            <span class="block text-[17px] sm:text-lg font-bold text-white tracking-tight font-display">Legcord</span>
            <span class="hidden sm:block text-[11px] font-medium tracking-[0.18em] uppercase text-white/45">Discord, elevated</span>
          </span>
        </a>

        <nav class="hidden md:block" aria-label="Primary">
          <ul class="flex items-center gap-1 rounded-2xl border border-white/[0.07] bg-white/[0.03] p-1.5 backdrop-blur">
            <li>
              <a href="/download" class="nav-link inline-block">Download</a>
            </li>
            <li>
              <a href="/plugins" class="nav-link inline-block">Plugins</a>
            </li>
            <li>
              <a href="/faq" class="nav-link inline-block">FAQ</a>
            </li>
            <li>
              <a href="https://github.com/sponsors/smartfrigde" target="_blank" rel="noopener noreferrer" class="nav-link inline-flex items-center gap-1.5">Donate <span class="text-[#f0abfc]">♥</span></a>
            </li>
            <li class="ml-1 flex items-center gap-1 pl-2 border-l border-white/10 pr-1">
              <a href="https://discord.gg/TnhxcqynZ2" target="_blank" rel="noopener noreferrer" class="group/icon p-2 rounded-xl hover:bg-white/[0.07] transition hover:-translate-y-0.5" aria-label="Discord">
                <Image src={discordIcon} alt="Discord" class="h-5 w-5 opacity-80 group-hover/icon:opacity-100 group-hover/icon:scale-110 transition" />
              </a>
              <a href="https://github.com/Legcord/Legcord" target="_blank" rel="noopener noreferrer" class="group/icon p-2 rounded-xl hover:bg-white/[0.07] transition hover:-translate-y-0.5" aria-label="GitHub">
                <Image src={githubIcon} alt="GitHub" class="h-5 w-5 opacity-80 group-hover/icon:opacity-100 group-hover/icon:scale-110 transition" />
              </a>
              <a href="/download" class="btn-primary !py-2 !px-5 !text-sm ml-1 hidden lg:inline-flex">Get app</a>
            </li>
          </ul>
        </nav>

        <div class="flex md:hidden items-center gap-2">
          <a href="/download" class="btn-primary !py-2 !px-4 !text-sm">Get app</a>
          <button class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/5 h-10 w-10 text-white hover:bg-white/10 transition active:scale-95" id="menu-toggle" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">
            <svg id="icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>

      <div class="md:hidden hidden border-t border-white/10 overflow-hidden" id="mobile-menu">
        <div class="px-4 py-3">
          <ul class="grid gap-1.5" id="mobile-links">
            <li><a href="/download" class="flex items-center justify-between rounded-2xl px-4 py-3 text-[15px] font-semibold text-white/85 hover:text-white bg-white/[0.04] hover:bg-[#5865f2]/20 border border-white/[0.06] transition">Download <span aria-hidden="true">→</span></a></li>
            <li><a href="/plugins" class="flex items-center justify-between rounded-2xl px-4 py-3 text-[15px] font-semibold text-white/85 hover:text-white bg-white/[0.04] hover:bg-[#5865f2]/20 border border-white/[0.06] transition">Plugins <span aria-hidden="true">→</span></a></li>
            <li><a href="/faq" class="flex items-center justify-between rounded-2xl px-4 py-3 text-[15px] font-semibold text-white/85 hover:text-white bg-white/[0.04] hover:bg-[#5865f2]/20 border border-white/[0.06] transition">FAQ <span aria-hidden="true">→</span></a></li>
            <li><a href="https://github.com/sponsors/smartfrigde" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-2xl px-4 py-3 text-[15px] font-semibold text-white/85 hover:text-white bg-white/[0.04] hover:bg-[#5865f2]/20 border border-white/[0.06] transition">Donate <span aria-hidden="true">↗</span></a></li>
            <li class="grid grid-cols-2 gap-1.5 pt-1">
              <a href="https://discord.gg/TnhxcqynZ2" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2.5 rounded-2xl px-4 py-3 text-sm font-semibold text-white/85 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.06] transition">
                <Image src={discordIcon} alt="Discord" class="h-5 w-5 opacity-90" /> Discord
              </a>
              <a href="https://github.com/Legcord/Legcord" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2.5 rounded-2xl px-4 py-3 text-sm font-semibold text-white/85 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.06] transition">
                <Image src={githubIcon} alt="GitHub" class="h-5 w-5 opacity-90" /> GitHub
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const mobileLinks = document.getElementById('mobile-links');

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      if (isHidden) {
        mobileMenu.classList.remove('hidden');
        requestAnimationFrame(() => {
          mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
          mobileMenu.style.opacity = '1';
        });
        mobileLinks?.querySelectorAll('li').forEach((li, i) => {
          li.style.opacity = '0';
          li.style.transform = 'translateY(10px)';
          setTimeout(() => {
            li.style.transition = 'all .45s cubic-bezier(.16,1,.3,1)';
            li.style.opacity = '1';
            li.style.transform = 'translateY(0)';
          }, 60 * i + 50);
        });
      } else {
        mobileMenu.style.maxHeight = '0px';
        mobileMenu.style.opacity = '0';
        setTimeout(() => mobileMenu.classList.add('hidden'), 300);
      }
      const isExpanded = isHidden;
      menuToggle.setAttribute('aria-expanded', String(isExpanded));
      iconOpen?.classList.toggle('hidden', isExpanded);
      iconClose?.classList.toggle('hidden', !isExpanded);
    });
    mobileMenu.style.maxHeight = '0px';
    mobileMenu.style.opacity = '0';
    mobileMenu.style.transition = 'max-height .35s cubic-bezier(.16,1,.3,1), opacity .3s';
    // active link highlight
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll('header nav a[href^="/"]').forEach((a) => {
      const href = a.getAttribute('href')?.replace(/\/$/, '') || '/';
      if (href === path || (href !== '/' && path.startsWith(href))) a.classList.add('active');
    });
  }
</script>
