<section class="relative overflow-hidden -mt-24 sm:-mt-28">
  <!-- deep aurora background -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-[#05070f]"></div>
    <div class="orb left-[-12%] top-[-18%] h-[560px] w-[560px] animate-aurora" style="background: radial-gradient(circle, rgba(88,101,242,.55), transparent 68%);"></div>
    <div class="orb right-[-10%] top-[-8%] h-[520px] w-[520px] animate-aurora" style="background: radial-gradient(circle, rgba(103,232,249,.28), transparent 68%); animation-delay:-5s;"></div>
    <div class="orb left-[28%] bottom-[-42%] h-[620px] w-[720px] animate-aurora" style="background: radial-gradient(circle, rgba(167,139,250,.32), transparent 68%); animation-delay:-9s;"></div>
    <div class="absolute inset-0 grid-bg opacity-70"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#05070f]"></div>
    <!-- orbit ring deco -->
    <div class="absolute right-[6%] top-[18%] hidden lg:block opacity-40">
      <div class="relative h-64 w-64">
        <div class="absolute inset-0 rounded-full border border-white/10"></div>
        <div class="absolute inset-6 rounded-full border border-dashed border-white/10 animate-spin-slow"></div>
        <div class="absolute left-1/2 top-0 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#67e8f9] shadow-[0_0_18px_4px_rgba(103,232,249,.7)]"></div>
