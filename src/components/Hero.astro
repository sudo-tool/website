            <dd class="mt-1 font-display text-lg font-bold text-white">Built-in</dd>
          </div>
          <div class="glass rounded-2xl px-4 py-3.5 card-lift">
            <dt class="text-[11px] font-semibold uppercase tracking-[0.14em] text-white/45">Price</dt>
            <dd class="mt-1 font-display text-lg font-bold text-emerald-300">Free</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-6 reveal visible" style="--d:140ms">
        <div class="relative" data-tilt>
