            <span class="flex -space-x-2">
              <span class="h-7 w-7 rounded-full border-2 border-[#0a0f22] bg-gradient-to-br from-[#5865f2] to-[#818cf8] grid place-items-center text-[11px] font-bold text-white">W</span>
              <span class="h-7 w-7 rounded-full border-2 border-[#0a0f22] bg-gradient-to-br from-[#06b6d4] to-[#67e8f9] grid place-items-center text-[11px] font-bold text-[#04202a]">M</span>
              <span class="h-7 w-7 rounded-full border-2 border-[#0a0f22] bg-gradient-to-br from-[#a78bfa] to-[#f0abfc] grid place-items-center text-[11px] font-bold text-white">L</span>
            </span>
            Windows • macOS • Linux
          </span>
          <span class="hidden sm:inline h-4 w-px bg-white/15"></span>
          <span class="inline-flex items-center gap-1.5">★ ★ ★ ★ ★ <span class="text-white/45">Loved by the community</span></span>
        </div>

        <!-- mini stats -->
        <dl class="mt-9 grid max-w-lg grid-cols-3 gap-3">
          <div class="glass rounded-2xl px-4 py-3.5 card-lift">
