      <div class="lg:col-span-6 reveal visible">
        <div class="flex flex-wrap items-center gap-2.5 mb-6">
          <span class="eyebrow">Free • Open source • Cross-platform</span>
          <span class="chip !border-emerald-300/20 !bg-emerald-400/10 !text-emerald-200"><span class="h-1.5 w-1.5 rounded-full bg-emerald-300 animate-pulse"></span> v4 ready</span>
        </div>
        <h1 class="text-[2.7rem] sm:text-6xl xl:text-[4.4rem] font-extrabold text-white leading-[0.98] tracking-tight text-balance">
          Enhance Your<br />
          <span class="text-gradient">Discord Experience</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-white/70 max-w-xl leading-relaxed text-balance">
          Legcord is a lightweight, customizable Discord client that puts you in control.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:gap-4 sm:items-center">
          <a href="/download" class="btn-primary text-[17px] group">
            <svg class="h-5 w-5 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0 0l-4-4m4 4l4-4"/></svg>
            Download Now
