          </div>
          <div class="absolute -right-3 sm:-right-6 bottom-10 animate-float-y" style="animation-delay:-3s">
            <div class="glass rounded-2xl px-4 py-3 flex items-center gap-3 shadow-card">
              <span class="grid h-9 w-9 place-items-center rounded-xl bg-[#5865f2]/20 text-[#a5b4fc] text-lg">✦</span>
              <span><span class="block text-sm font-bold text-white">Themes + mods</span><span class="block text-xs text-white/55">no injector</span></span>
            </div>
          </div>
        </div>
      </div>
