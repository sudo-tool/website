          <div class="absolute -inset-6 rounded-[28px] bg-gradient-to-br from-[#5865f2]/30 via-[#67e8f9]/12 to-[#a78bfa]/25 blur-2xl"></div>
          <!-- browser frame -->
          <div class="relative rounded-[22px] border border-white/12 bg-[#0a0f22]/80 backdrop-blur-xl shadow-[0_30px_90px_-18px_rgba(0,0,0,.8)] overflow-hidden" data-tilt-inner>
            <div class="flex items-center gap-2 px-5 py-3.5 border-b border-white/[0.08] bg-white/[0.03]">
