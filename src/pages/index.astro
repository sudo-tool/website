---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import FeatureCard from "@components/FeatureCard.astro";
import ImageModal from "@components/ImageModal.astro";
import Icon from "@components/Icon.astro";

const siteUrl = "https://legcord.app";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Legcord",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Windows, macOS, Linux",
      "description": "Legcord is a lightweight, open-source Discord client with custom themes, built-in mods, and privacy-first design. Available for Windows, Mac, and Linux.",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "url": `${siteUrl}/download`,
      "downloadUrl": `${siteUrl}/download`,
      "author": { "@type": "Organization", "name": "Legcord Team", "url": "https://github.com/Legcord" }
    },
    {
      "@type": "Organization",
      "name": "Legcord",
      "url": siteUrl,
      "sameAs": ["https://github.com/Legcord/Legcord", "https://discord.gg/TnhxcqynZ2"]
    }
  ]
};

---

<BaseLayout
  title="Legcord – Lightweight Discord Client"
  description="Legcord is a lightweight, open-source Discord client for Windows, Mac, and Linux. Custom themes, built-in mods, privacy-first. Download for free."
  canonical="/"
  image="/logo.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Hero />
  
  <!-- What is Legcord (SEO + intro) -->
  <section class="relative py-16 sm:py-20" aria-labelledby="what-is-legcord">
    <div class="orb left-[-8%] top-[10%] h-[380px] w-[420px] animate-aurora" style="background: radial-gradient(circle, rgba(88,101,242,.18), transparent 70%);"></div>
    <div class="relative container mx-auto px-4 max-w-3xl">
      <div class="reveal text-center mb-8">
        <span class="eyebrow">Discover</span>
        <h2 id="what-is-legcord" class="mt-4 font-display text-3xl sm:text-4xl font-extrabold text-white text-balance">
          <span class="text-gradient">What is Legcord?</span>
        </h2>
      </div>
      <div class="reveal glass rounded-[24px] p-8 sm:p-10 relative overflow-hidden card-lift" style="--d:120ms">
        <div class="absolute inset-x-10 top-0 h-px bg-gradient-to-r from-transparent via-[#818cf8]/60 to-transparent"></div>
        <div class="absolute -top-20 right-0 h-48 w-72 rounded-full bg-[radial-gradient(closest-side,rgba(103,232,249,.12),transparent)] blur-2xl"></div>
        <p class="relative text-gray-300/90 text-lg leading-relaxed mb-4">
          <strong class="text-white">Legcord</strong> is a free, open-source alternative Discord client that works on <strong class="text-white">Windows</strong>, <strong class="text-white">macOS</strong>, and <strong class="text-white">Linux</strong>. It uses the official Discord web app inside an optimized Electron wrapper, so you get the same servers, messages, and features—with less resources usage, built-in themes and mods, and stronger privacy. No injectors or separate mod installers are required: download Legcord, log in with your Discord account, and enable the options you want in settings.
        </p>
        <p class="relative text-gray-400/80 leading-relaxed">
          Whether you're on x64 or <strong class="text-gray-300">AArch64</strong> (including many Linux devices and ARM Windows machines), Legcord aims to give you a lightweight Discord experience with support for <strong class="text-gray-300">Wayland</strong> and X11 on Linux, native-feeling screensharing on Mac, and optional client mods like Equicord and Vencord for themes and plugins.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Why choose Legcord -->
  <section class="relative py-16 sm:py-20 border-y border-white/[0.06] bg-white/[0.015]" aria-labelledby="why-choose">
    <div class="absolute inset-0 grid-bg opacity-50"></div>
    <div class="relative container mx-auto px-4">
      <div class="reveal text-center mb-12">
        <span class="eyebrow">Benefits</span>
        <h2 id="why-choose" class="mt-4 font-display text-3xl md:text-[2.75rem] font-extrabold">
          <span class="text-gradient">Why choose Legcord?</span>
        </h2>
      </div>
      <div class="stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-5xl mx-auto">
        <div class="glass rounded-[20px] p-6 text-center card-lift group relative overflow-hidden">
          <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent"></div>
          <span class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-b from-[#5865f2]/35 to-[#5865f2]/10 border border-[#818cf8]/25 group-hover:scale-110 group-hover:-rotate-6 transition-transform duration-500 shadow-pop">
            <Icon name="chart-decreasing" class="h-7 w-7 text-[#a5b4fc]" />
          </span>
          <h3 class="font-display text-lg font-bold text-white mb-2">Smoother</h3>
          <p class="text-gray-400/80 text-sm leading-relaxed">Uses less resources than the official client. Perfect for gaming and older hardware.</p>
        </div>
        <div class="glass rounded-[20px] p-6 text-center card-lift group relative overflow-hidden">
          <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent"></div>
          <span class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-b from-[#a78bfa]/35 to-[#a78bfa]/10 border border-[#a78bfa]/25 group-hover:scale-110 group-hover:-rotate-6 transition-transform duration-500">
            <Icon name="shield" class="h-7 w-7 text-[#c4b5fd]" />
          </span>
          <h3 class="font-display text-lg font-bold text-white mb-2">Privacy-first</h3>
          <p class="text-gray-400/80 text-sm leading-relaxed">Built-in tracker blocking. We don't collect your data.</p>
        </div>
        <div class="glass rounded-[20px] p-6 text-center card-lift group relative overflow-hidden">
          <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent"></div>
          <span class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-b from-[#67e8f9]/25 to-[#67e8f9]/10 border border-[#67e8f9]/25 group-hover:scale-110 group-hover:-rotate-6 transition-transform duration-500">
            <Icon name="gear" class="h-7 w-7 text-[#67e8f9]" />
          </span>
          <h3 class="font-display text-lg font-bold text-white mb-2">Open source</h3>
          <p class="text-gray-400/80 text-sm leading-relaxed">Audit the code, contribute, or build themes and plugins.</p>
        </div>
        <div class="glass rounded-[20px] p-6 text-center card-lift group relative overflow-hidden">
          <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent"></div>
          <span class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-b from-[#34d399]/25 to-[#34d399]/10 border border-emerald-300/25 group-hover:scale-110 group-hover:-rotate-6 transition-transform duration-500">
            <Icon name="rocket" class="h-7 w-7 text-emerald-300" />
          </span>
          <h3 class="font-display text-lg font-bold text-white mb-2">Zero hassle</h3>
          <p class="text-gray-400/80 text-sm leading-relaxed">No injectors or installers. Download, run, and customize in settings.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-20">
    <div class="orb right-[-6%] top-[6%] h-[420px] w-[420px]" style="background: radial-gradient(circle, rgba(167,139,250,.14), transparent 70%);"></div>
    <div class="relative container mx-auto px-4">
      <div class="reveal text-center mb-12">
        <span class="eyebrow">Showcase</span>
        <h2 class="mt-4 font-display text-3xl md:text-[2.75rem] font-extrabold text-gradient">Key Features</h2>
      </div>
      <div class="stagger grid grid-cols-1 md:grid-cols-3 gap-6">
        <FeatureCard 
          title="Customizable" 
          description="Customize your Discord experience with themes and transparency options."
          emoji="artist-palette"
          image="/screenshots/transparent.png"
        />
        <FeatureCard 
          title="Built-in Client Mods" 
          description="Enjoy a smooth modded Discord experience without sacrificing performance."
          emoji="feather"
          image="/screenshots/mods.png"
        />
        <FeatureCard 
          title="Cross-Platform" 
          description="Works on Windows, macOS, and Linux, including AArch64 devices."
          emoji="desktop-computer"
          image="/screenshots/vista.png"
        />
      </div>
    </div>
  </section>
  
  <ImageModal id="modal-customizable" image="/screenshots/transparent.png" title="Customizable" />
  <ImageModal id="modal-built-in-client-mods" image="/screenshots/mods.png" title="Built-in Client Mods" />
  <ImageModal id="modal-cross-platform" image="/screenshots/vista.png" title="Cross-Platform" />
  
  <section class="relative py-20 border-y border-white/[0.06] bg-gradient-to-b from-white/[0.02] to-transparent">
    <div class="relative container mx-auto px-4">
      <div class="reveal text-center mb-12">
        <span class="eyebrow">For everyone</span>
        <h2 class="mt-4 font-display text-3xl md:text-[2.75rem] font-extrabold text-gradient">Legcord is great for...</h2>
      </div>
      <div class="stagger grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        <FeatureCard 
          title="Casual users"
          description="Legcord is built specifically for ease of use. You no longer have to deal with the hassle of installing mods. Just download, run and pick what suits you the best!"
          emoji="person"
        />
        <FeatureCard 
          title="Gamers"
          description="Are you tired of Discord app taking your precious resources in the background? Try out Legcord, it's much lighter and detects your games like a charm!"
          emoji="video-game"
        />
        <FeatureCard 
          title="Developers"
          description="Legcord is completely open source, you can create themes and plugins for it. It's very hackable and doesn't block you to look what's inside."
          emoji="technologist"
        />
        <FeatureCard 
          title="Linux users"
          description="Are you tired of the official app being sluggish, unresponsive and not working properly? Try out Legcord! It's built with Linux in mind and works flawlessly."
          emoji="penguin"
        />
      </div>
      
      <div class="reveal text-center mb-10">
        <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-white">
          <span class="text-gradient">
            Bonus Features
          </span>
        </h2>
      </div>
      <div class="stagger grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <FeatureCard 
          title="Made for Privacy™"
          description="Legcord automatically blocks all of Discord's trackers; even without any client mods, you can feel safe and secure! We also don't collect any data from you."
          emoji="shield"
        />
        <FeatureCard 
          title="Much more stable"
          description="Legcord is using a newer build of Electron than the stock Discord app. This means you can have a much more stable and secure experience, along with slightly better performance."
          emoji="check-mark-button"
        />
        <FeatureCard 
          title="Designed for Mac"
          description="Legcord is optimized for macOS, with a native screensharing and a more Mac-like experience. It's optimized for both Apple Sillicon and Intel macs! No more spinning fan when opening Discord."
          emoji="red-apple"
        />
        <FeatureCard 
          title="Audio screenshare"
          description="Legcord has a built-in audio screenshare feature, so you can share your audio with your friends without any hassle. (Linux/Windows only)"
          emoji="speaker-high-volume"
        />
      </div>
    </div>
  </section>

  <!-- Quick start -->
  <section class="relative py-20 border-t border-white/[0.06] overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-40"></div>
    <div class="relative container mx-auto px-4">
      <div class="reveal text-center mb-12">
        <span class="eyebrow">3 steps</span>
        <h2 class="mt-4 font-display text-3xl md:text-[2.75rem] font-extrabold text-gradient">Get started in 3 steps</h2>
      </div>
      <div class="stagger grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="glass relative flex flex-col items-center text-center group rounded-[22px] p-8 card-lift overflow-hidden">
          <div class="absolute inset-x-10 top-0 h-px bg-gradient-to-r from-transparent via-[#818cf8]/60 to-transparent"></div>
          <div class="relative w-16 h-16 rounded-2xl bg-gradient-to-br from-[#5865f2] to-[#4f46e5] text-white flex items-center justify-center text-2xl font-bold mb-4 shadow-pop group-hover:scale-110 group-hover:-rotate-6 transition-transform duration-500 font-display">1</div>
          <h3 class="font-display text-xl font-bold text-white mb-2">Download</h3>
          <p class="text-gray-400/80 text-sm mb-4">Pick your platform and grab the latest build from our download page.</p>
          <a href="/download" class="text-[#a5b4fc] hover:text-white font-semibold text-sm transition-colors link-underline">Go to downloads →</a>
        </div>
        <div class="glass relative flex flex-col items-center text-center group rounded-[22px] p-8 card-lift overflow-hidden">
          <div class="absolute inset-x-10 top-0 h-px bg-gradient-to-r from-transparent via-[#a78bfa]/60 to-transparent"></div>
          <div class="relative w-16 h-16 rounded-2xl bg-gradient-to-br from-[#8b5cf6] to-[#6d28d9] text-white flex items-center justify-center text-2xl font-bold mb-4 shadow-pop group-hover:scale-110 group-hover:-rotate-6 transition-transform duration-500 font-display">2</div>
          <h3 class="font-display text-xl font-bold text-white mb-2">Install & run</h3>
          <p class="text-gray-400/80 text-sm mb-4">Install like any other app, then log in with your Discord account.</p>
        </div>
        <div class="glass relative flex flex-col items-center text-center group rounded-[22px] p-8 card-lift overflow-hidden">
          <div class="absolute inset-x-10 top-0 h-px bg-gradient-to-r from-transparent via-[#67e8f9]/60 to-transparent"></div>
          <div class="relative w-16 h-16 rounded-2xl bg-gradient-to-br from-[#06b6d4] to-[#0e7490] text-white flex items-center justify-center text-2xl font-bold mb-4 shadow-pop group-hover:scale-110 group-hover:-rotate-6 transition-transform duration-500 font-display">3</div>
          <h3 class="font-display text-xl font-bold text-white mb-2">Customize</h3>
          <p class="text-gray-400/80 text-sm mb-4">Open Legcord settings to enable themes, mods, and transparency.</p>
          <a href="/plugins" class="text-[#a5b4fc] hover:text-white font-semibold text-sm transition-colors link-underline">Browse plugins →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Legcord vs official Discord (SEO) -->
  <section class="relative py-16 border-t border-white/[0.06]" aria-labelledby="legcord-vs-discord">
    <div class="relative container mx-auto px-4 max-w-4xl">
      <div class="reveal text-center mb-8">
        <span class="eyebrow">Comparison</span>
        <h2 id="legcord-vs-discord" class="mt-4 font-display text-3xl md:text-[2.75rem] font-extrabold text-gradient">
          Legcord vs official Discord
        </h2>
        <p class="text-gray-400/80 text-center mt-4 mb-2 max-w-2xl mx-auto">
          Legcord is not a replacement for Discord—it connects to the same Discord servers and uses your existing account. Here's how it differs from the official Discord app.
        </p>
      </div>
      <div class="reveal glass rounded-[22px] overflow-hidden">
        <div class="overflow-x-auto">
          <table class="fancy-table w-full border-collapse" role="table">
            <thead>
              <tr class="border-b border-white/[0.08] bg-white/[0.04]">
                <th class="text-left py-4 px-4 sm:px-6 text-white font-bold font-display">Feature</th>
                <th class="text-left py-4 px-4 sm:px-6 text-white/60 font-semibold">Official Discord</th>
                <th class="text-left py-4 px-4 sm:px-6 text-white font-bold font-display">Legcord</th>
              </tr>
            </thead>
            <tbody class="text-gray-300/80 text-sm">
              <tr class="border-b border-white/[0.06]">
                <td class="py-3.5 px-4 sm:px-6">Performance</td>
                <td class="py-3.5 px-4 sm:px-6">Stutters, long load times</td>
                <td class="py-3.5 px-4 sm:px-6 text-[#a5b4fc] font-semibold">Quick, smooth</td>
              </tr>
              <tr class="border-b border-white/[0.06]">
                <td class="py-3.5 px-4 sm:px-6">Themes & transparency</td>
                <td class="py-3.5 px-4 sm:px-6">Limited</td>
                <td class="py-3.5 px-4 sm:px-6 text-[#a5b4fc] font-semibold">Built-in</td>
              </tr>
              <tr class="border-b border-white/[0.06]">
                <td class="py-3.5 px-4 sm:px-6">Client mods (Shelter, Vencord)</td>
                <td class="py-3.5 px-4 sm:px-6">Not supported</td>
                <td class="py-3.5 px-4 sm:px-6 text-[#a5b4fc] font-semibold">Integrated</td>
              </tr>
              <tr class="border-b border-white/[0.06]">
                <td class="py-3.5 px-4 sm:px-6">Tracker blocking</td>
                <td class="py-3.5 px-4 sm:px-6">—</td>
                <td class="py-3.5 px-4 sm:px-6 text-[#a5b4fc] font-semibold">Default</td>
              </tr>
              <tr class="border-b border-white/[0.06]">
                <td class="py-3.5 px-4 sm:px-6">Open source</td>
                <td class="py-3.5 px-4 sm:px-6">No</td>
                <td class="py-3.5 px-4 sm:px-6 text-[#a5b4fc] font-semibold">Yes</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 sm:px-6">Linux / Wayland / AArch64</td>
                <td class="py-3.5 px-4 sm:px-6">Varies</td>
                <td class="py-3.5 px-4 sm:px-6 text-[#a5b4fc] font-semibold">First-class</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- System requirements -->
  <section class="relative py-16" aria-labelledby="system-requirements">
    <div class="relative container mx-auto px-4 max-w-3xl">
      <div class="reveal text-center mb-8">
        <h2 id="system-requirements" class="font-display text-3xl font-extrabold text-gradient">System requirements</h2>
      </div>
      <div class="reveal glass rounded-[20px] p-6 sm:p-8">
        <ul class="space-y-3 text-gray-300/80 text-sm">
          <li class="flex items-start gap-3 rounded-xl px-3 py-2.5 hover:bg-white/[0.04] transition">
            <span class="grid h-6 w-6 shrink-0 place-items-center rounded-lg bg-[#5865f2]/20 text-[#a5b4fc] text-xs">●</span>
            <span><strong class="text-white">Windows:</strong> Windows 10 or later (64-bit). AArch64 supported.</span>
          </li>
          <li class="flex items-start gap-3 rounded-xl px-3 py-2.5 hover:bg-white/[0.04] transition">
            <span class="grid h-6 w-6 shrink-0 place-items-center rounded-lg bg-[#a78bfa]/20 text-[#c4b5fd] text-xs">●</span>
            <span><strong class="text-white">macOS:</strong> macOS 12 (Monterey) or later. Apple Silicon and Intel.</span>
          </li>
          <li class="flex items-start gap-3 rounded-xl px-3 py-2.5 hover:bg-white/[0.04] transition">
            <span class="grid h-6 w-6 shrink-0 place-items-center rounded-lg bg-[#67e8f9]/15 text-[#67e8f9] text-xs">●</span>
            <span><strong class="text-white">Linux:</strong> Modern distro with Electron support. Wayland and X11. x64 and AArch64.</span>
          </li>
          <li class="flex items-start gap-3 rounded-xl px-3 py-2.5 hover:bg-white/[0.04] transition">
            <span class="grid h-6 w-6 shrink-0 place-items-center rounded-lg bg-emerald-400/15 text-emerald-300 text-xs">●</span>
            <span><strong class="text-white">RAM:</strong> 512 MB minimum; 2 GB or more recommended for a smooth experience.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-14 px-4">
    <div class="reveal relative mx-auto max-w-5xl overflow-hidden rounded-[28px] border border-white/12 bg-gradient-to-br from-[#1a2150] via-[#1e1b4b] to-[#0b3b4a] p-10 sm:p-14 text-center shadow-[0_30px_90px_-20px_rgba(88,101,242,.5)] noise">
      <div class="orb left-[-10%] top-[-40%] h-[380px] w-[380px] animate-aurora" style="background: radial-gradient(circle, rgba(88,101,242,.5), transparent 70%);"></div>
      <div class="orb right-[-8%] bottom-[-50%] h-[340px] w-[340px] animate-aurora" style="background: radial-gradient(circle, rgba(103,232,249,.28), transparent 70%); animation-delay:-6s;"></div>
      <div class="absolute inset-0 grid-bg opacity-60"></div>
      <div class="relative">
        <span class="eyebrow !bg-white/10 !border-white/20 !text-white">Join 100k+ users</span>
        <h2 class="mt-5 font-display text-3xl lg:text-[2.9rem] font-extrabold text-white text-balance">Ready to try Legcord?</h2>
        <p class="text-white/70 text-lg mt-3 mb-8 max-w-xl mx-auto">Download for your platform and join our community for support and updates.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
          <a href="/download" class="btn-primary !bg-none !bg-white !text-[#2b33a3] hover:!bg-white text-lg !px-10 shadow-xl">Download now</a>
          <a href="https://discord.gg/TnhxcqynZ2" target="_blank" rel="noopener noreferrer" class="btn-ghost text-lg !px-10">Join Discord</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
