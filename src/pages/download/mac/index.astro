---
import BaseLayout from "@layouts/BaseLayout.astro"
import Button from "@components/Button.astro";
import latest from "../../../../public/latest.json";
const version = latest.version;
---

<BaseLayout
  title="Download Legcord for macOS"
  description="Download Legcord for Mac. Universal binary for Apple Silicon and Intel. Lightweight Discord client with themes and mods."
  canonical="/download/mac"
>
  <div class="relative py-16 overflow-hidden">
    <div class="orb left-[50%] top-[-12%] h-[420px] w-[560px] -translate-x-1/2" style="background: radial-gradient(circle, rgba(167,139,250,.18), transparent 70%);"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="reveal visible text-center mb-10">
        <span class="eyebrow">Apple Silicon • Intel</span>
        <h1 class="mt-4 font-display text-4xl sm:text-5xl font-extrabold text-white">Download Legcord for macOS</h1>
      </div>
      <div class="max-w-2xl mx-auto">
        <h2 class="reveal text-xl font-bold text-white/80 mb-6 text-center font-display">Choose your macOS version:</h2>
        <div class="reveal glass rounded-[22px] p-6 sm:p-8 mb-5">
          <h3 class="text-lg font-bold text-white mb-4 text-center font-display">Universal binary</h3>
          <div class="grid gap-4">
            <Button name="DMG" href={`https://github.com/Legcord/Legcord/releases/download/v${version}/Legcord-${version}-mac-universal.dmg`} target="_blank" rel="noopener noreferrer" description="Disk image for easy installation" />
            <Button name="ZIP" href={`https://github.com/Legcord/Legcord/releases/download/v${version}/Legcord-${version}-mac-universal.zip`} target="_blank" rel="noopener noreferrer" description="Compressed archive" />
          </div>
        </div>
        <div class="reveal glass rounded-[22px] p-6 sm:p-8">
          <h3 class="text-lg font-bold text-white mb-4 text-center font-display">Package Manager</h3>
          <Button name="Homebrew" href={`https://github.com/Legcord/Legcord?tab=readme-ov-file#homebrew-repository`} target="_blank" rel="noopener noreferrer" description="Install using Homebrew package manager" />
        </div>
        <div class="mt-6 text-center">
          <p class="text-gray-300 text-sm">
            <a href="https://github.com/Legcord/Legcord/issues/560#issuecomment-2073419170" target="_blank" rel="noopener noreferrer" class="text-[#a5b4fc] hover:text-white link-underline">If macOS tells you the app is damaged, try this.</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
