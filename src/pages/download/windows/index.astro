---
import BaseLayout from "@layouts/BaseLayout.astro"
import Button from "@components/Button.astro";
import latest from "../../../../public/latest.json";
const version = latest.version;
---

<BaseLayout
  title="Download Legcord for Windows"
  description="Download Legcord for Windows 10/11. Lightweight Discord client for x64 and AArch64. Themes, mods, privacy."
  canonical="/download/windows"
>
  <div class="relative py-16 overflow-hidden">
    <div class="orb left-[10%] top-[-10%] h-[380px] w-[420px]" style="background: radial-gradient(circle, rgba(88,101,242,.22), transparent 70%);"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="reveal visible text-center mb-10">
        <span class="eyebrow">Windows 10 / 11</span>
        <h1 class="mt-4 font-display text-4xl sm:text-5xl font-extrabold text-white text-balance">Download Legcord for Windows 10/11</h1>
        <p class="mt-4 chip inline-flex">Latest: {version}</p>
      </div>
      <h2 class="reveal text-xl font-bold text-white/80 mb-6 text-center font-display">Select your system architecture:</h2>
      <div class="stagger grid grid-cols-1 md:grid-cols-2 gap-6">
        <Button name="64-bit (x64)" href={`https://github.com/Legcord/Legcord/releases/download/v${version}/Legcord-${version}-win-x64.exe`} target="_blank" rel="noopener noreferrer" description="For most modern computers" />
        <Button name="ARM64" href={`https://github.com/Legcord/Legcord/releases/download/v${version}/Legcord-${version}-win-arm64.exe`} target="_blank" rel="noopener noreferrer" description="For ARM-based devices" />
      </div>
      <div class="reveal mt-8 text-center glass rounded-2xl px-6 py-5">
        <p class="text-gray-300 text-sm">
          Not sure which architecture your system uses? 
          <a href="https://support.microsoft.com/en-us/windows/32-bit-and-64-bit-windows-frequently-asked-questions-c6ca9541-8dce-4d48-0415-94a3faa2e13d" class="text-[#a5b4fc] hover:text-white link-underline" target="_blank" rel="noopener noreferrer">
            Learn more about system architectures
          </a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
