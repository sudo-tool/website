---
import BaseLayout from "@layouts/BaseLayout.astro"
import IconButton from "@components/IconButton.astro";
import latest from "../../../public/latest.json";
const version = latest.version;
---

<BaseLayout
  title="Download Legcord"
  description="Download Legcord for Windows, macOS, or Linux. Lightweight Discord client with themes, mods, and privacy. Free and open source."
  canonical="/download"
>
  <article class="relative py-16 overflow-hidden" aria-labelledby="download-heading">
    <div class="orb left-[-10%] top-[0%] h-[420px] w-[420px] animate-aurora" style="background: radial-gradient(circle, rgba(88,101,242,.22), transparent 70%);"></div>
    <div class="orb right-[-8%] top-[20%] h-[380px] w-[380px]" style="background: radial-gradient(circle, rgba(103,232,249,.12), transparent 70%);"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="reveal visible text-center mb-12">
        <span class="eyebrow">Get the app</span>
        <h1 id="download-heading" class="mt-4 font-display text-4xl sm:text-5xl font-extrabold text-white">
          <span class="text-gradient">Download Legcord</span>
        </h1>
        <p class="text-gray-400 mt-4 mb-2 max-w-xl mx-auto">
          Pick your platform below. For release notes and older builds, see <a href="https://github.com/Legcord/Legcord/releases" target="_blank" rel="noopener noreferrer" class="text-[#a5b4fc] hover:text-white link-underline">GitHub releases</a>.
        </p>
        <p class="mt-3 inline-flex items-center gap-2 chip !text-emerald-200 !border-emerald-300/20 !bg-emerald-400/10">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-300 animate-pulse"></span>
          Latest version: <span id="latest-version" class="font-bold">{version}</span>
        </p>
      </header>
      <div class="stagger grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <IconButton 
          vectorIcon="/platform-icons/windows.svg" 
          name="Windows" 
          href={`/download/windows`}
          description="For Windows 10 and above"
        />
        <IconButton 
          vectorIcon="/platform-icons/linux.svg" 
          name="Linux" 
          href="/download/linux"
          description="For various Linux distributions"
        />
        <IconButton 
          vectorIcon="/platform-icons/mac.svg" 
          name="macOS" 
          href={`/download/mac`}
          description="For macOS 12 and above"
        />
      </div>
      <section class="reveal mt-12 text-center glass rounded-[22px] p-8 sm:p-10 max-w-3xl mx-auto" aria-labelledby="which-version">
        <h2 id="which-version" class="font-display text-2xl font-bold text-white mb-4">Not sure which version to choose?</h2>
        <p class="text-gray-300 max-w-2xl mx-auto mb-4 leading-relaxed">
          Legcord is available for <strong class="text-white">Windows</strong>, <strong class="text-white">Linux</strong>, and <strong class="text-white">macOS</strong>. Choose the download that matches your operating system. 
          If you're unsure, most modern computers use 64-bit (x64) versions.
        </p>
        <p class="text-gray-400 text-sm max-w-2xl mx-auto leading-relaxed">
          On Linux you can use the AppImage, .deb, or Flatpak depending on your distro. On Windows and Mac, run the installer and follow the prompts. After installing, open Legcord and log in with your Discord account—then head to <a href="/plugins" class="text-[#a5b4fc] hover:text-white link-underline">Plugins</a> to enable themes and mods.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
